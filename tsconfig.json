  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022"], "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "declaration": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
